{% if 'room' in capabilities %}
    alias(libs.plugins.ksp)
{% endif %}
{% if 'serialization' in capabilities %}
    alias(libs.plugins.kotlin.serialization)
{% endif %}
}

val signingFile = providers.environmentVariable("ANDROID_SIGNING_STORE_FILE").orNull
android {
    namespace = "{{ application_id }}"
    compileSdk = providers.gradleProperty("android.compileSdk").get().toInt()
    buildToolsVersion = providers.gradleProperty("android.buildTools").get()

    defaultConfig {
        applicationId = "{{ application_id }}"
        minSdk = providers.gradleProperty("android.minSdk").get().toInt()
        targetSdk = providers.gradleProperty("android.targetSdk").get().toInt()
        versionCode = providers.gradleProperty("app.versionCode").get().toInt()
        versionName = providers.gradleProperty("app.versionName").get()
        testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
    }

    signingConfigs {
        signingFile?.let { path ->
            create("releaseFromEnv") {
                storeFile = file(path)
                storePassword = providers.environmentVariable("ANDROID_SIGNING_STORE_PASSWORD").get()
                keyAlias = providers.environmentVariable("ANDROID_SIGNING_KEY_ALIAS").get()
                keyPassword = providers.environmentVariable("ANDROID_SIGNING_KEY_PASSWORD").get()
            }
        }
    }
    buildTypes {
        release {
            signingFile?.let { signingConfig = signingConfigs.getByName("releaseFromEnv") }
            isMinifyEnabled = true
            isShrinkResources = true
            proguardFiles(
                getDefaultProguardFile("proguard-android-optimize.txt"),
                "proguard-rules.pro",
            )
        }
    }

    buildFeatures {
        compose = true
    }
    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }
    testOptions {
        unitTests.isIncludeAndroidResources = true
    }
}

baselineProfile {
    automaticGenerationDuringBuild = false
}

