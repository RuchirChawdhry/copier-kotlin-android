package {{ application_id }}

import android.content.res.Configuration
import android.graphics.Bitmap
import androidx.compose.ui.test.assertIsDisplayed
import androidx.compose.ui.test.assertIsSelected
import androidx.compose.ui.test.assertTextEquals
import androidx.compose.ui.test.junit4.createAndroidComposeRule
import androidx.compose.ui.test.onAllNodesWithTag
import androidx.compose.ui.test.onNodeWithTag
import androidx.compose.ui.test.performClick
import androidx.test.platform.app.InstrumentationRegistry
import java.io.File
import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Rule
import org.junit.Test

private const val PNG_QUALITY = 100

class NavigationTest {
    @get:Rule
    val compose = createAndroidComposeRule<MainActivity>()

    @Test
    fun navigatesAndPreservesState() {
        val layout = when {
            hasNode("phone-navigation") -> "phone"
            hasNode("expanded-sidebar") -> "wide"
            else -> "rail"
        }
        val requested = InstrumentationRegistry.getArguments().getString("captureLayout")
        val captureLayout = requested ?: layout
        if (requested == "landscape") {
            assertEquals("wide", layout)
            assertEquals(
                Configuration.ORIENTATION_LANDSCAPE,
                compose.activity.resources.configuration.orientation,
            )
        } else {
            assertEquals(captureLayout, layout)
        }
        capture("$captureLayout-home")
        compose.onNodeWithTag("increment").performClick()
        compose.onNodeWithTag("counter").assertTextEquals("Count: 1")
        when (layout) {
            "phone" -> checkPhone()
            "wide" -> checkWide(captureLayout)
            else -> checkDestinations("rail")
        }
        compose.onNodeWithTag("counter").assertTextEquals("Count: 1")
    }

    private fun checkPhone() {
        compose.onNodeWithTag("bottom-HOME").assertIsSelected()
        compose.onNodeWithTag("open-drawer").performClick()
        compose.onNodeWithTag("phone-drawer").assertIsDisplayed()
        compose.onNodeWithTag("drawer-HOME").assertIsSelected()
        capture("phone-drawer")
        compose.onNodeWithTag("drawer-SETTINGS").performClick()
        compose.onNodeWithTag("settings").assertIsDisplayed()
        compose.onNodeWithTag("bottom-SETTINGS").assertIsSelected()
        capture("phone-settings")
        compose.onNodeWithTag("bottom-ABOUT").performClick()
        compose.onNodeWithTag("about").assertIsDisplayed()
        capture("phone-about")
        compose.onNodeWithTag("bottom-HOME").performClick()
    }

    private fun checkWide(layout: String) {
        checkDestinations("drawer")
        compose.onNodeWithTag("collapse-sidebar").performClick()
        compose.onNodeWithTag("navigation-rail").assertIsDisplayed()
        compose.onNodeWithTag("rail-HOME").assertIsSelected()
        capture("$layout-collapsed")
        checkDestinations("rail")
        compose.onNodeWithTag("expand-sidebar").performClick()
        compose.onNodeWithTag("expanded-sidebar").assertIsDisplayed()
        compose.onNodeWithTag("drawer-HOME").assertIsSelected()
    }

    private fun checkDestinations(prefix: String) {
        compose.onNodeWithTag("$prefix-HOME").assertIsSelected()
        compose.onNodeWithTag("$prefix-SETTINGS").performClick()
        compose.onNodeWithTag("settings").assertIsDisplayed()
        compose.onNodeWithTag("$prefix-SETTINGS").assertIsSelected()
        compose.onNodeWithTag("$prefix-ABOUT").performClick()
        compose.onNodeWithTag("about").assertIsDisplayed()
        compose.onNodeWithTag("$prefix-ABOUT").assertIsSelected()
        compose.onNodeWithTag("$prefix-HOME").performClick()
    }

    private fun hasNode(tag: String): Boolean =
        compose.onAllNodesWithTag(tag).fetchSemanticsNodes().isNotEmpty()

    private fun capture(name: String) {
        val theme = InstrumentationRegistry.getArguments().getString("captureTheme") ?: return
        compose.waitForIdle()
        val expected = when (theme) {
            "dark" -> Configuration.UI_MODE_NIGHT_YES
            "light" -> Configuration.UI_MODE_NIGHT_NO
            else -> error("Unknown screenshot theme: $theme")
        }
        val actual = compose.activity.resources.configuration.uiMode and
            Configuration.UI_MODE_NIGHT_MASK
        assertEquals(expected, actual)

        val instrumentation = InstrumentationRegistry.getInstrumentation()
        val directory = File(instrumentation.targetContext.filesDir, "screenshots")
        directory.mkdirs()
        val bitmap = requireNotNull(instrumentation.uiAutomation.takeScreenshot())
        try {
            File(directory, "$theme-$name.png").outputStream().use { stream ->
                assertTrue(bitmap.compress(Bitmap.CompressFormat.PNG, PNG_QUALITY, stream))
            }
        } finally {
            bitmap.recycle()
        }
    }
}
