package {{ application_id }}

import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material3.ColorScheme
import androidx.compose.material3.Shapes
import androidx.compose.material3.Typography
import androidx.compose.material3.darkColorScheme
import androidx.compose.material3.lightColorScheme
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.text.font.FontFamily
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.em
import androidx.compose.ui.unit.sp

/** Copier-selected, deliberately small visual language for phone and tablet. */
internal enum class VisualStyle { NATIVE, EDITORIAL, TECHNICAL }

internal val GeneratedVisualStyle = VisualStyle.{{ visual_style.upper() }}
internal val DefaultDynamicColors = GeneratedVisualStyle == VisualStyle.NATIVE

/** Shared spacing scale. Prefer these tokens over ad-hoc per-screen dimensions. */
internal object AppSpace {
    val xs = 4.dp
    val sm = 8.dp
    val md = 12.dp
    val lg = 16.dp
    val xl = 24.dp
    val section = 36.dp
}

internal val AppShapes: Shapes = when (GeneratedVisualStyle) {
    VisualStyle.NATIVE -> Shapes(
        small = RoundedCornerShape(12.dp),
        medium = RoundedCornerShape(16.dp),
        large = RoundedCornerShape(24.dp),
        extraLarge = RoundedCornerShape(28.dp),
    )
    VisualStyle.EDITORIAL -> Shapes(
        small = RoundedCornerShape(8.dp),
        medium = RoundedCornerShape(14.dp),
        large = RoundedCornerShape(24.dp),
        extraLarge = RoundedCornerShape(30.dp),
    )
    VisualStyle.TECHNICAL -> Shapes(
        small = RoundedCornerShape(4.dp),
        medium = RoundedCornerShape(8.dp),
        large = RoundedCornerShape(12.dp),
        extraLarge = RoundedCornerShape(16.dp),
    )
}

/** Material 3 defaults remain the base; each preset only adjusts its distinctive roles. */
internal val AppTypography: Typography = Typography().let { base ->
    when (GeneratedVisualStyle) {
        VisualStyle.NATIVE -> base.copy(
            headlineLarge = base.headlineLarge.copy(fontWeight = FontWeight.SemiBold),
            titleLarge = base.titleLarge.copy(fontWeight = FontWeight.SemiBold),
            titleMedium = base.titleMedium.copy(fontWeight = FontWeight.SemiBold),
        )
        VisualStyle.EDITORIAL -> base.copy(
            displayLarge = base.displayLarge.copy(fontFamily = FontFamily.Serif),
            headlineLarge = base.headlineLarge.copy(
                fontFamily = FontFamily.Serif,
                fontSize = 36.sp,
                lineHeight = 42.sp,
                fontWeight = FontWeight.Normal,
            ),
            headlineMedium = base.headlineMedium.copy(fontFamily = FontFamily.Serif),
            titleLarge = base.titleLarge.copy(
                fontFamily = FontFamily.Serif,
                fontSize = 27.sp,
                lineHeight = 33.sp,
            ),
            titleMedium = base.titleMedium.copy(fontWeight = FontWeight.SemiBold),
            bodyLarge = base.bodyLarge.copy(fontSize = 16.sp, lineHeight = 24.sp),
            labelSmall = base.labelSmall.copy(
                fontWeight = FontWeight.SemiBold,
                letterSpacing = 0.12.em,
            ),
        )
        VisualStyle.TECHNICAL -> base.copy(
            displayLarge = base.displayLarge.copy(
                fontFamily = FontFamily.Monospace,
                fontWeight = FontWeight.Bold,
                fontSize = 64.sp,
                lineHeight = 68.sp,
            ),
            headlineLarge = base.headlineLarge.copy(fontWeight = FontWeight.Bold),
            titleLarge = base.titleLarge.copy(fontWeight = FontWeight.Bold),
            titleMedium = base.titleMedium.copy(fontWeight = FontWeight.SemiBold),
            labelSmall = base.labelSmall.copy(
                fontFamily = FontFamily.Monospace,
                letterSpacing = 0.08.em,
            ),
        )
    }
}

internal fun presetColorScheme(dark: Boolean): ColorScheme = when (GeneratedVisualStyle) {
    VisualStyle.NATIVE -> if (dark) darkColorScheme() else lightColorScheme()
    VisualStyle.EDITORIAL -> if (dark) {
        darkColorScheme(
            primary = Color(0xFFFFB59F),
            onPrimary = Color(0xFF642514),
            background = Color(0xFF1B1714),
            onBackground = Color(0xFFF2E8DE),
            surface = Color(0xFF1B1714),
            onSurface = Color(0xFFF2E8DE),
            surfaceContainerLow = Color(0xFF29221E),
            outlineVariant = Color(0xFF58483E),
        )
    } else {
        lightColorScheme(
            primary = Color(0xFFAD3F1C),
            onPrimary = Color.White,
            background = Color(0xFFF8F4EC),
            onBackground = Color(0xFF1E1915),
            surface = Color(0xFFF8F4EC),
            onSurface = Color(0xFF1E1915),
            surfaceContainerLow = Color(0xFFF1E9DD),
            outlineVariant = Color(0xFFD8C8B8),
        )
    }
    VisualStyle.TECHNICAL -> if (dark) {
        darkColorScheme(
            primary = Color(0xFF9DE6CF),
            onPrimary = Color(0xFF00382B),
            background = Color(0xFF0D1317),
            onBackground = Color(0xFFE0E9EC),
            surface = Color(0xFF0D1317),
            onSurface = Color(0xFFE0E9EC),
            surfaceContainerLow = Color(0xFF192229),
            outlineVariant = Color(0xFF3F535B),
        )
    } else {
        lightColorScheme(
            primary = Color(0xFF076C59),
            onPrimary = Color.White,
            background = Color(0xFFF3F7F7),
            onBackground = Color(0xFF142429),
            surface = Color(0xFFF3F7F7),
            onSurface = Color(0xFF142429),
            surfaceContainerLow = Color(0xFFE6EEEE),
            outlineVariant = Color(0xFFB8C9CB),
        )
    }
}
