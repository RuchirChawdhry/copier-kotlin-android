@OptIn(ExperimentalComposeUiApi::class)
@Composable
internal fun AppNavigation(
    screen: Screen,
    onNavigate: (Screen) -> Unit,
    content: @Composable () -> Unit,
) {
    BoxWithConstraints(Modifier.fillMaxSize().semantics { testTagsAsResourceId = true }) {
        when {
            maxWidth >= 840.dp || (maxWidth >= 600.dp && maxWidth > maxHeight) -> {
                WideNavigation(screen, onNavigate, content)
            }

            maxWidth >= 600.dp -> Row(Modifier.fillMaxSize()) {
                AppRail(screen, onNavigate)
                Box(Modifier.weight(1f)) {
                    ScreenScaffold(screen, content = content)
                }
            }

            else -> PhoneNavigation(screen, onNavigate, content)
        }
    }
}

@Composable
private fun PhoneNavigation(
    screen: Screen,
    onNavigate: (Screen) -> Unit,
    content: @Composable () -> Unit,
) {
    val drawer = rememberDrawerState(DrawerValue.Closed)
    val scope = rememberCoroutineScope()
    ModalNavigationDrawer(
        drawerState = drawer,
        drawerContent = {
            ModalDrawerSheet(Modifier.testTag("phone-drawer")) {
                DrawerContents(screen, { destination ->
                    onNavigate(destination)
                    scope.launch { drawer.close() }
                })
            }
        },
    ) {
        ScreenScaffold(
            screen = screen,
            navigationIcon = {
                IconButton(
                    onClick = { scope.launch { drawer.open() } },
                    modifier = Modifier.testTag("open-drawer"),
                ) {
                    Icon(Icons.Filled.Menu, stringResource(R.string.open_navigation))
                }
            },
            bottomBar = { AppBottomBar(screen, onNavigate) },
            content = content,
        )
    }
}

@Composable
private fun WideNavigation(
    screen: Screen,
    onNavigate: (Screen) -> Unit,
    content: @Composable () -> Unit,
) {
    var expanded by rememberSaveable { mutableStateOf(true) }
    if (expanded) {
        PermanentNavigationDrawer(
            drawerContent = {
                ExpandedDrawer(screen, onNavigate) { expanded = false }
            },
        ) {
            ScreenScaffold(screen, content = content)
        }
    } else {
        Row(Modifier.fillMaxSize()) {
            AppRail(screen, onNavigate, onExpand = { expanded = true })
            Box(Modifier.weight(1f).fillMaxHeight()) {
                ScreenScaffold(screen, content = content)
            }
        }
    }
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun ScreenScaffold(
    screen: Screen,
    navigationIcon: @Composable () -> Unit = {},
    bottomBar: @Composable () -> Unit = {},
    content: @Composable () -> Unit,
) {
    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text(stringResource(screen.label)) },
                navigationIcon = navigationIcon,
            )
        },
        bottomBar = bottomBar,
    ) { padding ->
        Box(Modifier.padding(padding)) { content() }
    }
}
