package {{ application_id }}

import androidx.compose.foundation.layout.Arrangement
import androidx.compose.foundation.layout.Column
import androidx.compose.foundation.layout.Row
import androidx.compose.foundation.layout.fillMaxWidth
import androidx.compose.foundation.layout.padding
import androidx.compose.material3.Button
import androidx.compose.material3.FilterChip
import androidx.compose.material3.HorizontalDivider
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Switch
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.runtime.rememberCoroutineScope
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.platform.testTag
import kotlinx.coroutines.launch

@Composable
internal fun SettingsScreen(
    store: SettingsStore,
    theme: ThemeMode,
    dynamic: Boolean,
    descriptions: Boolean,
    compact: Boolean,
) {
    val scope = rememberCoroutineScope()
    Column(
        modifier = Modifier.fillMaxWidth().testTag("settings"),
        verticalArrangement = Arrangement.spacedBy(AppSpace.sm),
    ) {
        Text("Appearance", style = MaterialTheme.typography.titleLarge)
        ThemeMode.entries.chunked(2).forEach { modes ->
            Row(horizontalArrangement = Arrangement.spacedBy(AppSpace.sm)) {
                modes.forEach { mode ->
                    FilterChip(
                        selected = mode == theme,
                        onClick = { scope.launch { store.setTheme(mode) } },
                        label = { Text(mode.label) },
                        modifier = Modifier.testTag("theme-${mode.name}"),
                    )
                }
            }
        }
        SettingsToggle("Dynamic colors", "Use system wallpaper colors", dynamic, "dynamic-colors") {
            scope.launch { store.setDynamicColors(it) }
        }
        HorizontalDivider()
        Text("Search results", style = MaterialTheme.typography.titleLarge)
        SettingsToggle(
            "Show descriptions",
            "Display additional details in result cards",
            descriptions,
            "show-descriptions",
        ) { scope.launch { store.setShowDescriptions(it) } }
        SettingsToggle(
            "Compact results",
            "Reduce spacing between items",
            compact,
            "compact-results",
        ) {
            scope.launch { store.setCompactResults(it) }
        }
        HorizontalDivider()
        Button(onClick = { scope.launch { store.reset() } }) { Text("Reset preferences") }
    }
}

@Composable
private fun SettingsToggle(
    title: String,
    summary: String,
    checked: Boolean,
    tag: String,
    onChange: (Boolean) -> Unit,
) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = AppSpace.xs),
        verticalAlignment = Alignment.CenterVertically,
        horizontalArrangement = Arrangement.spacedBy(AppSpace.md),
    ) {
        Column(Modifier.weight(1f)) {
            Text(title, style = MaterialTheme.typography.titleMedium)
            Text(summary, style = MaterialTheme.typography.bodySmall)
        }
        Switch(checked, onChange, modifier = Modifier.testTag(tag))
    }
}
