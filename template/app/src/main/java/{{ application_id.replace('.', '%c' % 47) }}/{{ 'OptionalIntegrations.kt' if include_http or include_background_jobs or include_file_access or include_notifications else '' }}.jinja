package {{ application_id }}
{%- if include_file_access %}
import android.content.Intent
import android.net.Uri
import androidx.activity.result.contract.ActivityResultContracts
{%- endif %}
{%- if include_notifications %}
import android.Manifest
import android.app.NotificationChannel
import android.app.NotificationManager
import android.content.Context
import android.os.Build
{%- elif include_background_jobs %}
import android.content.Context
{%- endif %}
{%- if include_background_jobs %}
import androidx.work.OneTimeWorkRequestBuilder
import androidx.work.WorkManager
{%- endif %}
{%- if include_http %}
import okhttp3.OkHttpClient
import okhttp3.Request
{%- endif %}
{%- if include_file_access %}
internal fun documentPicker() = ActivityResultContracts.OpenDocument()

internal fun documentReadIntent(uri: Uri) = Intent(Intent.ACTION_VIEW).apply {
    setData(uri)
    addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
}
{%- endif %}
{%- if include_http %}
internal fun newHttpClient() = OkHttpClient()

internal fun httpGet(client: OkHttpClient, url: String) =
    client.newCall(Request.Builder().url(url).build())
{%- endif %}
{%- if include_background_jobs %}
internal fun enqueueSampleJob(context: Context) {
    WorkManager.getInstance(context).enqueue(OneTimeWorkRequestBuilder<SampleWorker>().build())
}
{%- endif %}
{%- if include_notifications %}
internal fun notificationPermission(): String? =
    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
        Manifest.permission.POST_NOTIFICATIONS
    } else {
        null
    }

internal fun createNotificationChannel(context: Context) {
    val manager = context.getSystemService(NotificationManager::class.java)
    manager.createNotificationChannel(
        NotificationChannel("general", "General", NotificationManager.IMPORTANCE_DEFAULT),
    )
}
{%- endif %}
