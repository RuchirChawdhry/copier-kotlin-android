import androidx.lifecycle.compose.collectAsStateWithLifecycle
import androidx.lifecycle.viewmodel.compose.viewModel

@Composable
fun App() {
    val model: AppViewModel = viewModel()
    val context = LocalContext.current
    val store = remember(context) { SettingsStore(context) }
    val theme by store.theme.collectAsStateWithLifecycle(ThemeMode.SYSTEM)
    val dynamic by store.dynamicColors.collectAsStateWithLifecycle(DefaultDynamicColors)
    val descriptions by store.showDescriptions.collectAsStateWithLifecycle(true)
    val compact by store.compactResults.collectAsStateWithLifecycle(false)
    AppTheme(theme, dynamic) {
        AppNavigation(model.screen, model::navigate) {
            Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.TopCenter) {
                Column(
                    modifier = Modifier
                        .fillMaxWidth()
                        .widthIn(max = 840.dp)
                        .padding(AppSpace.xl)
                        .verticalScroll(remember(model.screen) { ScrollState(0) }),
                    verticalArrangement = Arrangement.spacedBy(AppSpace.lg),
                ) {
                    when (model.screen) {
                        Screen.HOME -> {
                            HomeContent(model.count, model::increment)
                            LibraryScreen(descriptions, compact)
                        }
                        Screen.SETTINGS -> SettingsScreen(
                            store,
                            theme,
                            dynamic,
                            descriptions,
                            compact,
                        )
                        Screen.ABOUT -> Text(
                            stringResource(R.string.about_description),
                            Modifier.testTag("about"),
                        )
                    }
                }
            }
        }
    }
}

{% if not include_wear -%}
internal fun increment(value: Int): Int = value + 1

{% endif -%}
@Composable
private fun HomeContent(count: Int, onIncrement: () -> Unit) {
    AppArtwork()
    AppSectionHeading(
        eyebrow = "YOUR WORKSPACE",
        title = "Build what matters",
        supporting = "A focused starting point for your next Android idea.",
    )
    AppInfoCard(title = "Live preview", supporting = "State survives rotation and navigation.") {
        if (GeneratedVisualStyle == VisualStyle.TECHNICAL) {
            Text(count.toString(), style = MaterialTheme.typography.displayLarge)
        }
        Text(stringResource(R.string.counter, count), Modifier.testTag("counter"))
        Button(onClick = onIncrement, modifier = Modifier.testTag("increment")) {
            Text(stringResource(R.string.increment))
        }
    }
}
