<manifest xmlns:android="http://schemas.android.com/apk/res/android">
{% if include_http or 'lan' in capabilities or 'algolia' in ui_addons %}
    <uses-permission android:name="android.permission.INTERNET" />
{% endif %}
{% if 'lan' in capabilities %}
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
{% endif %}
{% if 'camera' in capabilities %}
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
{% endif %}
{% if 'bluetooth' in capabilities %}
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
{% endif %}
{% if include_notifications %}
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
{% endif %}
    <application android:label="@string/app_name" android:icon="@drawable/ic_app_logo" android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false" android:supportsRtl="true">
        <profileable android:shell="true" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
