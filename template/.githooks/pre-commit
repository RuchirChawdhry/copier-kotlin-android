#!/usr/bin/env bash
set -euo pipefail
# Format staged Kotlin files only using ktlint's Gradle include filter.
mapfile -d '' files < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.kt' '*.kts')
(("${#files[@]}")) || exit 0
for file in "${files[@]}"; do
    if ! git diff --quiet -- "$file"; then
        echo "Stage or stash unstaged edits in $file before committing." >&2
        exit 1
    fi
done
# Gradle ktlint format does not offer reliable per-file CLI filtering for every source set.
# Run the check instead of changing unstaged files.
./gradlew ktlintCheck

