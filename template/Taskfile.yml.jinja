version: '3'
tasks:
  bootstrap:
    cmd: bash scripts/bootstrap.sh
  setup:
    cmd: bash scripts/setup.sh
  doctor:
    cmd: bash scripts/dev.sh python3 scripts/doctor.py
  doctor:json:
    cmd: bash scripts/dev.sh python3 scripts/doctor.py
  dev:
    cmds:
      - task: emulator:start
      - task: run
  fix:
    cmd: bash scripts/dev.sh ./gradlew ktlintFormat
  check:
    cmd: bash scripts/dev.sh ./gradlew ktlintCheck detekt lintDebug
  test:tooling:
    cmd: python3 scripts/test-tooling.py
  test:
    cmd: bash scripts/dev.sh ./gradlew testDebugUnitTest
  build:
    cmd: bash scripts/dev.sh ./gradlew assembleDebug
  build:phone:
    cmd: bash scripts/dev.sh ./gradlew :app:assembleDebug
{% if include_wear %}
  build:wear:
    cmd: bash scripts/dev.sh ./gradlew :wear:assembleDebug
{% endif %}
  release:
    cmd: bash scripts/dev.sh ./gradlew assembleRelease bundleRelease
  release:phone:
    cmd: bash scripts/dev.sh ./gradlew :app:assembleRelease :app:bundleRelease
{% if include_wear %}
  release:wear:
    cmd: bash scripts/dev.sh ./gradlew :wear:assembleRelease :wear:bundleRelease
{% endif %}
  emulator:
    cmd: bash scripts/emulator.sh start
  emulator:create:
    cmd: bash scripts/emulator.sh create
  emulator:start:
    cmd: bash scripts/emulator.sh start
  emulator:stop:
    cmd: bash scripts/emulator.sh stop
  emulator:status:
    cmd: bash scripts/emulator.sh status
  emulator:reset:
    cmd: bash scripts/emulator.sh reset
  install:
    cmd: bash scripts/dev.sh ./gradlew :app:installDebug
  run:
    cmds:
      - task: install
      - bash scripts/dev.sh adb shell am start -n {{ application_id }}/.MainActivity
  test:ui:
    cmd: bash scripts/dev.sh ./gradlew connectedDebugAndroidTest
  screenshots:
    cmd: bash scripts/dev.sh bash scripts/screenshots.sh
  logs:
    cmd: bash scripts/dev.sh adb logcat -d
  benchmark:
    cmd: bash scripts/dev.sh bash scripts/benchmark.sh device
  benchmark:startup:
    cmd: bash scripts/dev.sh bash scripts/benchmark.sh device
  benchmark:memory:
    cmd: bash scripts/dev.sh bash scripts/benchmark.sh memory
  benchmark:scroll:
    cmd: bash scripts/dev.sh bash scripts/benchmark.sh frames
  benchmark:size:
    cmd: bash scripts/dev.sh bash scripts/benchmark.sh size
  benchmark:profile:
    cmd: bash scripts/dev.sh bash scripts/benchmark.sh profile
  benchmark:report:
    cmd: bash scripts/dev.sh bash scripts/benchmark.sh report
  test:all:
    cmds:
      - task: check
      - task: test
      - task: build
      - task: test:ui

  device:list:
    cmd: bash scripts/dev.sh python3 scripts/device.py list {{ '{{.CLI_ARGS}}' }}
  device:info:
    cmd: bash scripts/dev.sh python3 scripts/device.py info {{ '{{.CLI_ARGS}}' }}
  device:inspect:
    cmd: bash scripts/dev.sh python3 scripts/device.py inspect {{ '{{.CLI_ARGS}}' }}
  device:screenshot:
    cmd: bash scripts/dev.sh python3 scripts/device.py screenshot {{ '{{.CLI_ARGS}}' }}
  device:tap:
    cmd: bash scripts/dev.sh python3 scripts/device.py tap {{ '{{.CLI_ARGS}}' }}
  device:type:
    cmd: bash scripts/dev.sh python3 scripts/device.py type {{ '{{.CLI_ARGS}}' }}
  device:back:
    cmd: bash scripts/dev.sh python3 scripts/device.py back {{ '{{.CLI_ARGS}}' }}
  device:home:
    cmd: bash scripts/dev.sh python3 scripts/device.py home {{ '{{.CLI_ARGS}}' }}
  device:permissions:
    cmd: bash scripts/dev.sh python3 scripts/device.py permissions {{ '{{.CLI_ARGS}}' }}
  device:crashes:
    cmd: bash scripts/dev.sh python3 scripts/device.py crashes {{ '{{.CLI_ARGS}}' }}
  device:restart:
    cmd: bash scripts/dev.sh python3 scripts/device.py restart {{ '{{.CLI_ARGS}}' }}
  device:clear:
    cmd: bash scripts/dev.sh python3 scripts/device.py clear {{ '{{.CLI_ARGS}}' }}
  device:theme:
    cmd: bash scripts/dev.sh python3 scripts/device.py theme {{ '{{.CLI_ARGS}}' }}
